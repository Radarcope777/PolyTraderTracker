modules = ["nodejs-20"]

[nix]
channel = "stable-24_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Subgraph Compiler"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "subgraph"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "File inspection"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Local Subgraph Compiler"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend Dev Server"

[[workflows.workflow]]
name = "Subgraph Compiler"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install -g @graphprotocol/graph-cli && npm install && npm run codegen && npm run build"

[[workflows.workflow]]
name = "subgraph"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "ls -la && find . -type f -name \"*.ts\" -o -name \"*.graphql\" -o -name \"*.yaml\" | sort"

[[workflows.workflow]]
name = "File inspection"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cat schema.graphql && echo \"---\" && cat subgraph.yaml"

[[workflows.workflow]]
name = "Local Subgraph Compiler"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run codegen && npm run build"

[[workflows.workflow]]
name = "Frontend Dev Server"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run start"
waitForPort = 5000

[deployment]
run = ["sh", "-c", "npm install -g @graphprotocol/graph-cli && npm install && npm run codegen && npm run build"]

[[ports]]
localPort = 5000
externalPort = 80
